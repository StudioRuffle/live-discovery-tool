# Supabase project URL and anon (public) key — from Supabase dashboard:
# Project Settings > API. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — Project Settings > API.
# NEVER expose this to the client. Server-only, used by facilitator actions
# to bypass RLS. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Shared PIN/password gating the facilitator side of the app.
# Server-only — checked in a server action, never shipped to the client.
FACILITATOR_PIN=
